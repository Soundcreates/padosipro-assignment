# Leave SMTP_USER / SMTP_PASS empty to use Mailpit (docker compose).
# View OTP emails at http://localhost:8025
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_MAIL_FROM=

# Used only when SMTP_USER/SMTP_PASS are empty (Compose sets MAILPIT_HOST=mailpit).
# If you run the API on the host against Compose Mailpit, set:
# MAILPIT_HOST=localhost
MAILPIT_HOST=
MAILPIT_PORT=1025

# Optional when running backend outside Docker
DATABASE_URL=postgresql://dev_user:a_secure_dev_password@localhost:5432/dev_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10
PORT=3003
